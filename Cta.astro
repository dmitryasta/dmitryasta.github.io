---
import ContactForm from './ContactForm.astro';
import Arrow from './Arrow.astro';
import { href, type Lang } from '../lib/pages';
import { ui } from '../i18n';
import { SITE } from '../lib/site';
import type { Topic } from '../lib/form';
interface Props {
  lang: Lang;
  pageId?: string;
  /** Embed the enquiry form in the band (service pages). Without it the band links to the form on the Contact page. */
  form?: boolean;
  /** Topic of the form: preselected in the embedded form, or passed to the Contact page in the link. */
  topic?: Topic;
}
const { lang, pageId = 'contact', form = false, topic } = Astro.props;
const t = ui(lang);
const contactHref = `${href(lang, 'contact')}${topic ? `?topic=${topic}` : ''}#enquiry`;
---
{form ? (
  <section class="section--tight" aria-labelledby="cta-h">
    <div class="container">
      <div class="cta cta--form reveal">
        <div class="cta__copy">
          <h2 id="cta-h">{t.form.title}</h2>
          <p>{t.home.cta.text}</p>
          <div class="cta__direct">
            <a class="link-arrow" href={`mailto:${SITE.email}`}>{SITE.email}</a>
            <a class="link-arrow" href={SITE.linkedin} rel="me noopener" target="_blank">{t.common.linkedinLabel}</a>
          </div>
        </div>
        <div class="enquiry__card">
          <ContactForm lang={lang} pageId={pageId} topic={topic} showTitle={false} />
        </div>
      </div>
    </div>
  </section>
) : (
  <section class="section--tight" aria-labelledby="cta-h">
    <div class="container">
      <div class="cta reveal">
        <h2 id="cta-h">{t.home.cta.h2}</h2>
        <p>{t.home.cta.text}</p>
        <div class="cta__row">
          <a class="btn btn--primary" href={contactHref}>{t.common.contactCta}<Arrow /></a>
          <a class="btn btn--ghost" href={`mailto:${SITE.email}`}>{t.home.cta.mail}</a>
          <a class="link-arrow" href={SITE.linkedin} rel="me noopener" target="_blank">{t.common.linkedinLabel}</a>
        </div>
      </div>
    </div>
  </section>
)}
