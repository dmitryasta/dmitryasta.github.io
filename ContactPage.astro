---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Arrow from '../components/Arrow.astro';
import { href, absUrl, type Lang } from '../lib/pages';
import { ui } from '../i18n';
import { SITE } from '../lib/site';
import { graph, breadcrumbNode, websiteNode, personNode } from '../lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);
const c = t.contact;
const ld = graph([
  websiteNode(lang),
  personNode(lang, true),
  { '@type': 'ContactPage', '@id': `${absUrl(lang, 'contact')}#page`, url: absUrl(lang, 'contact'), name: c.title, description: c.description, inLanguage: lang, about: { '@id': personNode(lang, false)['@id'] } },
  breadcrumbNode([{ name: t.nav.home, url: absUrl(lang, 'home') }, { name: t.nav.contact, url: absUrl(lang, 'contact') }]),
]);
---
<Base lang={lang} pageId="contact" title={c.title} description={c.description} jsonLd={ld}>
  <PageHero crumbs={[{ name: t.nav.home, href: href(lang, 'home') }, { name: t.nav.contact }]} crumbsLabel={t.a11y.breadcrumbs} h1={c.h1} lead={c.lead} />
  <section class="section section--tight">
    <div class="container stack">
      <div class="contact-layout">
        <div class="enquiry__card reveal">
          <ContactForm lang={lang} pageId="contact" topicFromUrl={true} />
        </div>
        <div class="contact-side">
          <div class="contact-card reveal" style="--d:.06s">
            <h2>{c.altTitle}</h2>
            <a class="big" href={`mailto:${SITE.email}`}>{SITE.email}</a>
            <p>{c.emailText}</p>
            <a class="big big--sm" href={SITE.linkedin} rel="me noopener" target="_blank">linkedin.com/in/dmitry-astakhov-6a153b</a>
            <p>{c.linkedinText}</p>
          </div>
          <div class="contact-card reveal" style="--d:.12s">
            <h2>{c.includeTitle}</h2>
            <ul class="ticks">{c.include.map((x) => <li>{x}</li>)}</ul>
          </div>
        </div>
      </div>
      <div class="block">
        <h2>{c.nextTitle}</h2>
        <ol class="steps steps--row">{c.next.map((s) => <li><div><h3>{s.t}</h3><p>{s.d}</p></div></li>)}</ol>
      </div>
      <p class="note">{c.based}</p>
    </div>
  </section>
</Base>
