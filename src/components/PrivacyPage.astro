---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { href, absUrl, type Lang } from '../lib/pages';
import { ui } from '../i18n';
import { graph, breadcrumbNode, websiteNode } from '../lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);
const p = t.privacy;
const ld = graph([websiteNode(lang), breadcrumbNode([{ name: t.nav.home, url: absUrl(lang, 'home') }, { name: p.h1, url: absUrl(lang, 'privacy') }])]);
---
<Base lang={lang} pageId="privacy" title={p.title} description={p.description} jsonLd={ld}>
  <PageHero crumbs={[{ name: t.nav.home, href: href(lang, 'home') }, { name: p.h1 }]} crumbsLabel={t.a11y.breadcrumbs} h1={p.h1} lead={p.lead} />
  <section class="section section--tight">
    <div class="container">
      <div class="prose">
        <p class="updated">{p.updated}</p>
        {p.body.map((b) => (<><h2>{b.h}</h2><p>{b.p}</p></>))}
      </div>
    </div>
  </section>
</Base>
