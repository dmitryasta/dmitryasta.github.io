---
interface Props { class?: string; size?: number }
const { class: cls = '', size = 40 } = Astro.props;
const uid = 'bm' + Math.random().toString(36).slice(2, 7);
---
<svg class={cls} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={uid} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#4D8DFF" /><stop offset="1" stop-color="#42C8E8" /></linearGradient>
  </defs>
  <rect width="64" height="64" rx="16" fill="#0B1F3A" />
  <rect x="1.5" y="1.5" width="61" height="61" rx="14.5" fill="none" stroke={`url(#${uid})`} stroke-width="2" />
  <text x="32" y="41.5" text-anchor="middle" font-family="Manrope Variable, Manrope, system-ui, sans-serif" font-weight="800" font-size="25" letter-spacing="-1.5" fill="#F4F7FB">DA</text>
  <rect x="45" y="13" width="5" height="5" rx="1" transform="rotate(45 47.5 15.5)" fill="#C9A227" />
</svg>
