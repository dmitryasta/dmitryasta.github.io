---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import Arrow from '../components/Arrow.astro';
import { href, absUrl, ARTICLE_IDS, type Lang } from '../lib/pages';
import { getEntry, type ArticleMeta } from '../lib/content';
import { ui } from '../i18n';
import { graph, breadcrumbNode, websiteNode, personNode } from '../lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);
const p = t.insightsPage;
const articles = ARTICLE_IDS.map((id) => ({ id, ...getEntry<ArticleMeta>(lang, id).frontmatter }));
const ld = graph([
  websiteNode(lang),
  personNode(lang, false),
  { '@type': 'CollectionPage', '@id': `${absUrl(lang, 'insights')}#page`, url: absUrl(lang, 'insights'), name: p.title, description: p.description, inLanguage: lang },
  { '@type': 'ItemList', itemListElement: articles.map((a, i) => ({ '@type': 'ListItem', position: i + 1, name: a.h1, url: absUrl(lang, `art:${a.id}`) })) },
  breadcrumbNode([{ name: t.nav.home, url: absUrl(lang, 'home') }, { name: t.nav.insights, url: absUrl(lang, 'insights') }]),
]);
---
<Base lang={lang} pageId="insights" title={p.title} description={p.description} jsonLd={ld}>
  <PageHero crumbs={[{ name: t.nav.home, href: href(lang, 'home') }, { name: t.nav.insights }]} crumbsLabel={t.a11y.breadcrumbs} h1={p.h1} lead={p.lead} />
  <section class="section section--tight">
    <div class="container">
      <div class="insights insights--list">
        {articles.map((a, i) => (
          <a class="post reveal" style={`--d:${(i % 2) * 0.08}s`} href={href(lang, `art:${a.id}`)}>
            <div class="post__meta"><span class="post__topic">{a.topic}</span><time datetime={a.date}>{a.date}</time></div>
            <h2 style="font-size:1.3rem">{a.h1}</h2>
            <p>{a.description}</p>
            <span class="link-arrow">{t.common.readMore}<Arrow /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <Cta lang={lang} />
</Base>
