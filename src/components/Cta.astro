---
import { href, type Lang } from '../lib/pages';
import { ui } from '../i18n';
import { SITE } from '../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);
---
<section class="section--tight" aria-labelledby="cta-h">
  <div class="container">
    <div class="cta reveal">
      <h2 id="cta-h">{t.home.cta.h2}</h2>
      <p>{t.home.cta.text}</p>
      <div class="cta__row">
        <a class="btn btn--primary" href={`mailto:${SITE.email}`}>{t.home.cta.mail}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="btn btn--ghost" href={SITE.linkedin} rel="me noopener" target="_blank">{t.home.cta.linkedin}</a>
        <a class="link-arrow" href={href(lang, 'contact')}>{t.nav.contact}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>
