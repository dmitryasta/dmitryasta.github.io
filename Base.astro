---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { LANGS, HTML_LANG, HREFLANG, OG_LOCALE, absUrl, absAsset, asset, type Lang } from '../lib/pages';
import { assertParity, ui } from '../i18n';
import { SITE } from '../lib/site';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import manropeLatinExt from '@fontsource-variable/manrope/files/manrope-latin-ext-wght-normal.woff2?url';
import manropeCyr from '@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interLatinExt from '@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2?url';
import interCyr from '@fontsource-variable/inter/files/inter-cyrillic-wght-normal.woff2?url';

interface Props {
  lang: Lang;
  pageId: string;
  title: string;
  description: string;
  type?: 'website' | 'article';
  jsonLd?: unknown;
  published?: string;
  modified?: string;
  noindex?: boolean;
}
assertParity();
const { lang, pageId, title, description, type = 'website', jsonLd, published, modified, noindex = false } = Astro.props;
const canonical = absUrl(lang, pageId);
const ogImage = absAsset(`og/og-${lang}.png`);
const preload = [manropeLatin, interLatin, ...(lang === 'ru' ? [manropeCyr, interCyr] : []), ...(lang === 'sr' ? [manropeLatinExt, interLatinExt] : [])];
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1'} />
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content="#071426" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={HREFLANG[l]} href={absUrl(l, pageId)} />)}
    <link rel="alternate" hreflang="x-default" href={absUrl('en', pageId)} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    {preload.map((u) => <link rel="preload" href={u} as="font" type="font/woff2" crossorigin />)}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={`${SITE.name} | ${SITE.tagline}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} | ${SITE.tagline}`} />
    {type === 'article' && published && <meta property="article:published_time" content={published} />}
    {type === 'article' && modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {jsonLd && <JsonLd data={jsonLd} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{ui(lang).a11y.skip}</a>
    <Header lang={lang} pageId={pageId} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script is:inline>
      (function () {
        var d = document, h = d.querySelector('[data-header]');
        function onScroll() { if (h) h.classList.toggle('is-scrolled', window.scrollY > 8); }
        onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
        var tg = d.querySelector('[data-menu-toggle]'), nav = d.querySelector('[data-nav]');
        if (tg && nav) {
          function set(open) { tg.setAttribute('aria-expanded', open ? 'true' : 'false'); nav.classList.toggle('is-open', open); }
          tg.addEventListener('click', function () { set(tg.getAttribute('aria-expanded') !== 'true'); });
          d.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
          nav.addEventListener('click', function (e) { if (e.target.closest && e.target.closest('a')) set(false); });
        }
        var els = [].slice.call(d.querySelectorAll('.reveal'));
        if ('IntersectionObserver' in window && els.length) {
          var io = new IntersectionObserver(function (en) { en.forEach(function (x) { if (x.isIntersecting) { x.target.classList.add('is-in'); io.unobserve(x.target); } }); }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
          els.forEach(function (el) { io.observe(el); });
          setTimeout(function () { els.forEach(function (el) { el.classList.add('is-in'); }); }, 4000);
        } else { els.forEach(function (el) { el.classList.add('is-in'); }); }
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var fine = window.matchMedia && window.matchMedia('(pointer: fine)').matches;
        var art = d.querySelector('[data-hero-art]');
        if (art && !reduce && fine) {
          var host = art.closest('.hero') || art;
          host.addEventListener('pointermove', function (e) {
            var r = host.getBoundingClientRect();
            art.style.setProperty('--px', (((e.clientX - r.left) / r.width) * 2 - 1).toFixed(3));
            art.style.setProperty('--py', (((e.clientY - r.top) / r.height) * 2 - 1).toFixed(3));
          });
          host.addEventListener('pointerleave', function () { art.style.setProperty('--px', 0); art.style.setProperty('--py', 0); });
        }
        if (!reduce && fine) {
          [].forEach.call(d.querySelectorAll('.tile'), function (t) {
            t.addEventListener('pointermove', function (e) { var r = t.getBoundingClientRect(); t.style.setProperty('--x', (e.clientX - r.left) + 'px'); t.style.setProperty('--y', (e.clientY - r.top) + 'px'); });
          });
        }
      })();
    </script>
  </body>
</html>
