---
import Breadcrumbs from './Breadcrumbs.astro';
interface Props { crumbs: { name: string; href?: string }[]; crumbsLabel: string; eyebrow?: string; h1: string; lead?: string }
const { crumbs, crumbsLabel, eyebrow, h1, lead } = Astro.props;
---
<section class="page-hero">
  <div class="bg-grid"></div>
  <div class="container">
    <Breadcrumbs items={crumbs} label={crumbsLabel} />
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{h1}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
