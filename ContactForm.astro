---
// Reusable enquiry form (all three languages). Sends to Formspree with fetch; see src/lib/form.ts.
import { ui, UIS } from '../i18n';
import { href, absUrl, type Lang } from '../lib/pages';
import { SITE } from '../lib/site';
import { formEndpoint, type Topic } from '../lib/form';
interface Props {
  lang: Lang;
  pageId: string;
  /** Topic preselected on the server (service pages). */
  topic?: Topic;
  /** Contact page: take the topic from ?topic=... in the address. */
  topicFromUrl?: boolean;
  /** Show the form title as a heading (h2). Off inside the CTA band, where the band owns the heading. */
  showTitle?: boolean;
  /** Show the short lead under the title. */
  showLead?: boolean;
}
const { lang, pageId, topic, topicFromUrl = false, showTitle = true, showLead = true } = Astro.props;
const t = ui(lang);
const f = t.form;
const endpoint = formEndpoint();
const enOptions = UIS.en.form.topic.options;
const privacyParts = f.privacy.split('{link}');
const msg = {
  sending: f.sending,
  submit: f.submit,
  errors: f.errors,
  fail: f.fail,
  unavailable: f.unavailable,
  success: f.success,
};
---
<div class="enquiry" id="enquiry" data-enquiry-root>
  {showTitle && <h2 class="enquiry__title" id="enquiry-title">{f.title}</h2>}
  {showTitle && showLead && <p class="enquiry__lead">{f.lead}</p>}
  <form
    class="enquiry__form"
    method="post"
    action={endpoint || undefined}
    data-enquiry
    data-endpoint={endpoint}
    data-mail={SITE.email}
    data-msg={JSON.stringify(msg)}
    data-topic-url={topicFromUrl ? '1' : undefined}
    aria-labelledby={showTitle ? 'enquiry-title' : undefined}
    aria-label={showTitle ? undefined : f.title}
  >
    <div class="enquiry__grid">
      <div class="field">
        <label for="enq-name">{f.name.label}<span class="req" aria-hidden="true"> *</span></label>
        <input id="enq-name" name="name" type="text" autocomplete="name" required maxlength="120" placeholder={f.name.placeholder} data-field="name" aria-describedby="enq-name-err" />
        <p class="field__err" id="enq-name-err" hidden></p>
      </div>
      <div class="field">
        <label for="enq-email">{f.email.label}<span class="req" aria-hidden="true"> *</span></label>
        <input id="enq-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" placeholder={f.email.placeholder} data-field="email" aria-describedby="enq-email-err" />
        <p class="field__err" id="enq-email-err" hidden></p>
      </div>
      <div class="field">
        <label for="enq-company">{f.company.label}<span class="opt"> ({f.optional})</span></label>
        <input id="enq-company" name="company" type="text" autocomplete="organization" maxlength="160" placeholder={f.company.placeholder} />
      </div>
      <div class="field">
        <label for="enq-topic">{f.topic.label}</label>
        <select id="enq-topic" name="topic" data-field="topic">
          <option value="" data-code="">{f.topic.placeholder}</option>
          {f.topic.options.map((o, i) => (
            <option value={enOptions[i].t} data-code={o.c} selected={topic === o.c}>{o.t}</option>
          ))}
        </select>
      </div>
      <div class="field field--full">
        <label for="enq-message">{f.message.label}<span class="req" aria-hidden="true"> *</span></label>
        <textarea id="enq-message" name="message" rows="6" required maxlength="5000" placeholder={f.message.placeholder} data-field="message" aria-describedby="enq-message-err"></textarea>
        <p class="field__err" id="enq-message-err" hidden></p>
      </div>
    </div>
    <div class="enquiry__trap" aria-hidden="true">
      <label>{f.trap}<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
    </div>
    <input type="hidden" name="source_page" value={absUrl(lang, pageId)} />
    <input type="hidden" name="language" value={lang} />
    <input type="hidden" name="_subject" value="Website enquiry" />
    <div class="enquiry__status" data-status role="alert" aria-live="assertive"></div>
    <div class="enquiry__actions">
      <button class="btn btn--primary" type="submit" data-submit>
        <span data-label>{f.submit}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </button>
      <p class="enquiry__note">{privacyParts[0]}<a href={href(lang, 'privacy')}>{f.privacyLink}</a>{privacyParts[1] ?? ''}</p>
    </div>
  </form>
  <div class="enquiry__done" data-done tabindex="-1" role="status" hidden>
    <span class="enquiry__done-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
    </span>
    <h3 data-done-title></h3>
    <p data-done-text></p>
    <button class="btn btn--ghost btn--sm" type="button" data-again></button>
  </div>
</div>

<script>
  type Msg = {
    sending: string;
    submit: string;
    errors: { name: string; email: string; emailInvalid: string; message: string; summary: string };
    fail: { title: string; text: string };
    unavailable: { title: string; text: string };
    success: { title: string; text: string; again: string };
  };

  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function init(form: HTMLFormElement) {
    const root = form.closest('[data-enquiry-root]') as HTMLElement;
    const msg = JSON.parse(form.dataset.msg || '{}') as Msg;
    const endpoint = form.dataset.endpoint || '';
    const mail = form.dataset.mail || '';
    const status = root.querySelector('[data-status]') as HTMLElement;
    const done = root.querySelector('[data-done]') as HTMLElement;
    const btn = form.querySelector('[data-submit]') as HTMLButtonElement;
    const label = btn.querySelector('[data-label]') as HTMLElement;
    const name = form.elements.namedItem('name') as HTMLInputElement;
    const email = form.elements.namedItem('email') as HTMLInputElement;
    const message = form.elements.namedItem('message') as HTMLTextAreaElement;
    const topic = form.elements.namedItem('topic') as HTMLSelectElement;
    const trap = form.elements.namedItem('_gotcha') as HTMLInputElement;
    let busy = false;

    form.noValidate = true; // our own accessible messages replace the browser bubbles

    if (form.dataset.topicUrl) {
      const wanted = new URLSearchParams(location.search).get('topic');
      if (wanted) {
        const opt = Array.from(topic.options).find((o) => o.dataset.code === wanted);
        if (opt) topic.value = opt.value;
      }
    }

    function errEl(input: HTMLElement) {
      return document.getElementById(input.getAttribute('aria-describedby') || '') as HTMLElement | null;
    }
    function setErr(input: HTMLInputElement | HTMLTextAreaElement, text: string) {
      const el = errEl(input);
      if (text) {
        input.setAttribute('aria-invalid', 'true');
        if (el) { el.textContent = text; el.hidden = false; }
      } else {
        input.removeAttribute('aria-invalid');
        if (el) { el.textContent = ''; el.hidden = true; }
      }
    }
    function check(input: HTMLInputElement | HTMLTextAreaElement): string {
      const v = input.value.trim();
      if (input === name) return v ? '' : msg.errors.name;
      if (input === email) return !v ? msg.errors.email : EMAIL.test(v) && v.length <= 254 ? '' : msg.errors.emailInvalid;
      if (input === message) return v ? '' : msg.errors.message;
      return '';
    }
    function showStatus(html: HTMLElement | null) {
      // The live region stays in the page (empty when idle) so that screen readers announce what is put into it.
      status.replaceChildren();
      if (html) status.appendChild(html);
    }
    function notice(title: string, text: string, withMail: boolean) {
      const box = document.createElement('div');
      box.className = 'enquiry__alert';
      const h = document.createElement('strong'); h.textContent = title;
      const p = document.createElement('p'); p.textContent = text + ' ';
      if (withMail) {
        const a = document.createElement('a'); a.href = 'mailto:' + mail; a.textContent = mail;
        p.appendChild(a); p.appendChild(document.createTextNode('.'));
      }
      box.append(h, p);
      showStatus(box);
    }
    function lock(on: boolean) {
      busy = on;
      btn.disabled = on;
      btn.classList.toggle('is-busy', on);
      form.setAttribute('aria-busy', on ? 'true' : 'false');
      label.textContent = on ? msg.sending : msg.submit;
    }

    [name, email, message].forEach((input) => {
      input.addEventListener('blur', () => { if (input.value.trim() || input.getAttribute('aria-invalid')) setErr(input, check(input)); });
      input.addEventListener('input', () => { if (input.getAttribute('aria-invalid')) setErr(input, check(input)); });
    });

    function validate(): boolean {
      const fields = [name, email, message];
      let firstBad = -1;
      fields.forEach((input, i) => {
        const e = check(input);
        setErr(input, e);
        if (e && firstBad < 0) firstBad = i;
      });
      if (firstBad >= 0) {
        const summary = document.createElement('div');
        summary.className = 'enquiry__alert';
        const p = document.createElement('p'); p.textContent = msg.errors.summary;
        summary.appendChild(p);
        showStatus(summary);
        fields[firstBad].focus();
        return false;
      }
      showStatus(null);
      return true;
    }

    function success() {
      form.reset();
      form.hidden = true;
      showStatus(null);
      (done.querySelector('[data-done-title]') as HTMLElement).textContent = msg.success.title;
      (done.querySelector('[data-done-text]') as HTMLElement).textContent = msg.success.text;
      (done.querySelector('[data-again]') as HTMLElement).textContent = msg.success.again;
      done.hidden = false;
      done.focus();
    }

    (done.querySelector('[data-again]') as HTMLElement).addEventListener('click', () => {
      done.hidden = true;
      form.hidden = false;
      name.focus();
    });

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (busy) return;
      if (!validate()) return;
      // Hidden trap field: a person never fills it. Pretend success to a bot, send nothing.
      if (trap && trap.value) { success(); return; }
      if (!endpoint) { notice(msg.unavailable.title, msg.unavailable.text, true); return; }

      lock(true);
      const fd = new FormData(form);
      fd.set('source_page', location.origin + location.pathname);
      const topicLabel = topic.value || 'General';
      fd.set('_subject', 'Website enquiry: ' + topicLabel + ' | ' + name.value.trim());
      const ctrl = new AbortController();
      const timer = window.setTimeout(() => ctrl.abort(), 20000);
      try {
        const res = await fetch(endpoint, { method: 'POST', body: fd, headers: { Accept: 'application/json' }, signal: ctrl.signal });
        if (res.ok) { success(); return; }
        let emailRejected = false;
        try {
          const data = await res.json();
          emailRejected = Array.isArray(data?.errors) && data.errors.some((e: { field?: string }) => e.field === 'email');
        } catch { /* body is not JSON */ }
        if (emailRejected) { setErr(email, msg.errors.emailInvalid); email.focus(); }
        else notice(msg.fail.title, msg.fail.text, true);
      } catch {
        notice(msg.fail.title, msg.fail.text, true);
      } finally {
        window.clearTimeout(timer);
        lock(false);
      }
    });
  }

  document.querySelectorAll<HTMLFormElement>('form[data-enquiry]').forEach(init);
</script>
